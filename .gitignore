# --- ATAK takdev ---
# Dependencies the takdev plugin downloads/extracts from the SDK.
.takdev/

# --- Signing ---
# The debug keystore is copied into build/ by takdev, but keep any stray
# keystores or credential files out of history regardless.
*.jks
*.keystore
android_keystore
apikey.properties

