<?xml version="1.0" encoding="utf-8"?>
<!-- Gives each radio row a pressable, button-like surface. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/row_pressed" />
            <corners android:radius="4dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/row_normal" />
            <corners android:radius="4dp" />
            <stroke
                android:width="1dp"
                android:color="@color/row_border" />
        </shape>
    </item>

</selector>
